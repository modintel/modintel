:3000 {
	log {
		output file /var/log/caddy/dashboard-access.json
		format json
	}

	handle /api/v1/auth/* {
		reverse_proxy auth-service:8084
	}

	handle /api/v1/users* {
		reverse_proxy auth-service:8084
	}

	handle /api/v1/settings* {
		reverse_proxy auth-service:8084
	}

	handle /api/training/* {
		reverse_proxy training-api:8085
	}

	reverse_proxy review-api:8082 {
		trusted_proxies private_ranges
		flush_interval 0
	}
}